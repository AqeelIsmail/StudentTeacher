        <member name="M:Authentication_API.Controllers.CoursesController.GetCourses">
            <summary>
            Retrieves all available courses.
            </summary>
            <remarks>
            This endpoint can be accessed by authenticated
            Students and Teachers.
            </remarks>
            <returns>
            A list of available courses.
            </returns>
            <response code="200">
            Courses retrieved successfully.
            </response>
            <response code="401">
            The user is not authenticated.
            </response>
        </member>
        <member name="M:Authentication_API.Controllers.CoursesController.GetCourse(System.Int32)">
            <summary>
            Retrieves a specific course by its ID.
            </summary>
            <remarks>
            This endpoint can be accessed by authenticated
            Students and Teachers.
            </remarks>
            <param name="id">
            The unique ID of the course to retrieve.
            </param>
            <returns>
            The requested course and its details, if found.
            </returns>
            <response code="200">
            The course was retrieved successfully.
            </response>
            <response code="401">
            The user is not authenticated.
            </response>
            <response code="404">
            No course was found with the specified ID.
            </response>
        </member>
